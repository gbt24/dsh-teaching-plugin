{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/teaching-core/src/**/*.ts",
    "packages/teaching-core/tests/**/*.ts",
    "packages/dsh-plugin/src/**/*.ts",
    "packages/dsh-plugin/src/**/*.tsx",
    "packages/dsh-plugin/tests/**/*.ts"
  ],
  "exclude": ["node_modules", "**/lib/**", "**/dist/**"]
}
