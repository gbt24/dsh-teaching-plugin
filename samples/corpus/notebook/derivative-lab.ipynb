   "source": [
    "# Notebook：导数实验\n",
    "\n",
    "块级公式如下：\n",
    "\n",
    "$$\n",
    "f'(x) = \\lim_{h \\to 0} \\frac{f(x+h)-f(x)}{h}\n",
    "$$\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "数值导数结果: 2.0000000001\n"
     ]
    }
   ],
   "source": [
    "def numeric_derivative(f, x, h=1e-6):\n",
    "    return (f(x + h) - f(x - h)) / (2 * h)\n",
    "\n",
    "print(\"数值导数结果:\", numeric_derivative(lambda t: t * t, 1.0))\n"
   ]
  },
