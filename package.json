{
  "name": "deepseek-teaching-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI knowledge-base teaching plugin for DeepSeek Harness Desktop",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "build:spike": "node scripts/build-spike.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
